{
  "name": "comparador-supermercados",
  "version": "1.0.0",
  "description": "Comparador de precios de Mercadona, Consum, DIA y LIDL",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "build": "node build.js",
    "test": "node build.js && node --test \"tests/*.test.js\" && npm run test:py",
    "test:py": ".venv/bin/python -m unittest discover -s tests -p \"test_*.py\"",
    "test:hoy": "CATALOGO=app/catalogo.json node --test \"tests/*.test.js\"",
    "servir": "cd app && python3 -m http.server 8765"
  },
  "devDependencies": {
    "playwright": "^1.64.1",
    "terser": "^5.51.2"
  },
  "private": true
}
